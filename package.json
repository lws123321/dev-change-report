{
  "name": "dev-change-report",
  "version": "1.5.2",
  "description": "整理代码改动或技术实践成可粘贴的富文本文档，支持开发改动说明与知识分享文章两种模式",
  "keywords": [
    "copilot",
    "skill",
    "changelog",
    "report",
    "ckeditor",
    "rich-text",
    "code-review",
    "documentation"
  ],
  "bin": {
    "dcr": "bin/dcr.js"
  },
  "files": [
    "bin",
    "lib",
    "SKILL.md",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lws123321/dev-change-report.git"
  },
  "homepage": "https://github.com/lws123321/dev-change-report#readme",
  "bugs": {
    "url": "https://github.com/lws123321/dev-change-report/issues"
  },
  "author": "Linweisong",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "postinstall": "node bin/postinstall.js",
    "bundle": "node tools/bundle.js",
    "sea:blob": "node --experimental-sea-config packaging/sea-config.json",
    "exe": "npm run bundle && npm run sea:blob && node tools/make-exe.js",
    "pack:win": "npm run exe && node tools/pack-win.js"
  },
  "devDependencies": {
    "postject": "^1.0.0-alpha.6"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT"
}
